{
  "name": "expense-splitter",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "frontend"
  ],
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "scripts": {
    "start:backend": "cd backend && mvn spring-boot:run",
    "start:frontend": "cd frontend && npm run dev",
    "start": "concurrently \"npm run start:backend\" \"npm run start:frontend\""
  }
}